{
  "name": "bemmy",
  "version": "1.0.4",
  "description": "Dependency-free utility to compose CSS classnames following the BEM convention.",
  "author": {
    "name": "Kyle Payne",
    "url": "https://github.com/motogoozy"
  },
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motogoozy/bemmy.git"
  },
  "homepage": "https://github.com/motogoozy/bemmy#readme",
  "bugs": {
    "url": "https://github.com/motogoozy/bemmy/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run lint && npm run prettier && npm run clean && npm run build:cjs && npm run build:mjs",
    "build:cjs": "tsc --project ./tsconfig.cjs.json && mv dist/cjs/index.js dist/index.cjs && rm -rf dist/cjs",
    "build:mjs": "tsc",
    "clean": "rm -rf dist",
    "lint": "npx eslint",
    "prettier": "npx prettier --check .",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "keywords": [
    "BEM",
    "CSS",
    "class",
    "classname",
    "classes",
    "classnames",
    "composer",
    "generator",
    "maker",
    "style",
    "styles",
    "javascript",
    "js",
    "jsx",
    "typescript",
    "ts",
    "tsx",
    "react",
    "node",
    "nodejs"
  ]
}
